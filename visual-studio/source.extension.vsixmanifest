    <DisplayName>Matrix Phosphor Theme</DisplayName>
    <Description xml:space="preserve">A preview of a monochrome phosphor-green theme for Visual Studio 2022 and Visual Studio 2026.</Description>
    <License>LICENSE.txt</License>
