  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "markup.quote"],
      "settings": { "foreground": "#4C9460", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "#A7FFB8" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#70E58C" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#8BFFA4", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#70E58C" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#59D977" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"],
      "settings": { "foreground": "#77F29A" }
    },
    {
      "scope": ["entity.name.tag", "support.constant.property-value"],
      "settings": { "foreground": "#8BFFA4" }
    },
    {
      "scope": ["entity.other.attribute-name", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#70E58C" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter", "identifier"],
      "settings": { "foreground": "#78F592" }
    },
    {
      "scope": ["variable.language", "support.variable", "this", "super"],
      "settings": { "foreground": "#C8FFD4", "fontStyle": "italic" }
    },
    {
      "scope": ["punctuation.definition.string", "punctuation.definition.tag", "meta.brace"],
      "settings": { "foreground": "#68CC7A" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#C8FFD4", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#A7FFB8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#77F29A", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8BFFA4", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": { "foreground": "#020B05", "background": "#C8FFD4", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#77F29A",
    "type": "#77F29A",
    "class": "#77F29A",
    "enum": "#77F29A",
    "interface": "#77F29A",
    "struct": "#77F29A",
    "typeParameter": "#70E58C",
    "parameter": "#78F592",
    "variable": "#78F592",
    "property": "#70E58C",
    "enumMember": "#C8FFD4",
    "function": "#59D977",
    "method": "#59D977",
    "macro": "#8BFFA4",
    "keyword": { "foreground": "#8BFFA4", "bold": true },
    "comment": { "foreground": "#4C9460", "italic": true },
    "string": "#A7FFB8",
    "number": "#70E58C",
    "regexp": "#77F29A",
    "operator": "#70E58C",
    "decorator": "#8BFFA4",
    "*.readonly": "#C8FFD4",
    "*.deprecated": { "foreground": "#4C9460", "strikethrough": true }
  }
}
